#!/usr/bin/env bash
#
# Pre-push: the live e2e suite (scripts/e2e.sh, ~4 min) when the pushed commits touch the bot — unless a full run
# already passed on bit-identical code (.dev/e2e-passed, written by scripts/e2e.sh).
# Activate once per clone:   git config core.hooksPath .githooks
# Skip for a single push:    git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

ZERO="0000000000000000000000000000000000000000"
relevant=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # deleting a remote branch
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$(git rev-list "$local_sha" --not --remotes | tail -n 1)"
    files="$( [ -n "$range" ] && git diff --name-only "$range^" "$local_sha" 2>/dev/null || true)"
  else
    files="$(git diff --name-only "$remote_sha" "$local_sha")"
  fi
  if printf '%s\n' "$files" | grep -Eq '^(backend/|scripts/e2e\.sh$|compose\.e2e\.yml$)'; then
    relevant=1
  fi
done
[ "$relevant" -eq 1 ] || exit 0

stamp="$ROOT/.dev/e2e-passed"
if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$("$ROOT/scripts/e2e-fingerprint.sh")" ]; then
  echo "▶ pre-push: e2e tests skipped — a full run already passed on identical code."
  exit 0
fi

fail() {
  echo "✗ $1"
  echo
  echo "To push anyway:  git push --no-verify"
  exit 1
}

echo "▶ pre-push: e2e tests (scripts/e2e.sh)"
[ -f "$ROOT/.env.e2e" ] || fail ".env.e2e is missing — the e2e tests cannot run (setup: docs/testing.md)."
docker info >/dev/null 2>&1 || fail "Docker is not running (e.g. 'colima start') — the e2e tests need a throwaway Postgres."
"$ROOT/scripts/e2e.sh" </dev/null || fail "e2e tests failed."
