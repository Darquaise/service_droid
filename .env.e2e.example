# Settings for the end-to-end tests (scripts/e2e.sh). Copy to .env.e2e (gitignored) and fill in.
# One-time Discord setup: docs/testing.md

# Bot token of a non-production bot, e.g. the local dev bot from .env. NEVER a production bot's token
# (refused by the harness): the run syncs the test command set over that bot's slash commands.
DISCORD_TOKEN=your_test_bot_token_here

# The test guild (the test bot must be in it, with Administrator)
E2E_GUILD_ID=

# User ids of 2-3 other bots that are members of the test guild. They are never driven, only used as authors.
# The first one gets an Administrator role per run and is the author of admin commands.
E2E_DUMMY_USER_IDS=111111111111111111,222222222222222222,333333333333333333

# DATABASE_URL is set by scripts/e2e.sh (throwaway local Postgres). Only localhost is accepted.
